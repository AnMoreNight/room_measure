# Copy this file to .env and fill in real values for local development.
# .env is gitignored — never commit real secrets. On Vercel, set these as
# Project Environment Variables instead.

# OpenAI — vision model used by lib/measure/wall-detection.ts and
# floor-detection.ts to find the measurement lines in each photo.
# OPENAI_MODEL defaults to "gpt-4o" if unset; o3 is noticeably more
# reliable on hard cases (steeply-angled tiled walls that resemble floor)
# at the cost of much higher latency (~25s vs ~5s per call).
OPENAI_API_KEY=
OPENAI_MODEL=o3

# Google Sheets — service account with read access to the toilet reference
# sheet (GOOGLE_SHEET_ID), used by /api/toilet-lookup to look up a toilet's
# known size by brand/model. GOOGLE_SERVICE_ACCOUNT_JSON is the service
# account's JSON key, as a single-line string. See lib/sheets-client.ts.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=
